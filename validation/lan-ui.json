      "open",
      "closed"
    ],
    "uiThemes": [
      "Negi",
      "Day",
      "Night"
    ],
    "uiLanguages": [
      "zh-Hans",
      "ja",
      "en"
    ],
    "pausedTrackAndSettingsPagePreservedAcrossAppearanceChanges": true,
    "macEndpointReadback": "Speaker / 44100 Hz / EQ enabled / paused"
  },
  "notVerified": [
    "physical iOS USB DAC",
    "physical folding",
    "physical Local Network permission prompt",
    "physical background/lock screen",
    "long-duration or adverse network soak",
    "all movie/container variants"
  ]
